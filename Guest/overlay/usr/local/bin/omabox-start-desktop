#!/bin/bash
set -euo pipefail

export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe
export LP_NUM_THREADS
LP_NUM_THREADS=$(nproc)
export OMABOX_DISPLAY_SCALE=auto

for option in $(cat /proc/cmdline); do
  case "$option" in
    omabox.display_scale=auto|omabox.display_scale=1|omabox.display_scale=2)
      OMABOX_DISPLAY_SCALE=${option#*=}
      ;;
    omabox.render_threads=*)
      candidate=${option#*=}
      if [[ $candidate =~ ^[0-9]+$ ]] && (( candidate >= 1 && candidate <= 64 )); then
        LP_NUM_THREADS=$candidate
      fi
      ;;
  esac
done

readonly preferences="$HOME/.config/omabox"
readonly config="$HOME/.config/hypr/hyprland.lua"
mkdir -p "$preferences"
if [[ ! -e $preferences/desktop.env ]]; then
  install -m 0600 /usr/local/share/omabox/desktop.env "$preferences/desktop.env"
fi
if [[ ! -e $preferences/hyprland.lua ]]; then
  install -m 0644 /usr/local/share/omabox/hyprland.lua "$preferences/hyprland.lua"
fi
source /usr/local/libexec/omabox-desktop-environment.sh
omabox_load_desktop_environment "$preferences/desktop.env" /mnt/omabox-config/desktop.env
export OMABOX_GUEST_PREFERENCES="$preferences"

integration='dofile("/usr/local/share/omabox/runtime.lua")'
if [[ -f $config ]] && grep -Fxq 'dofile("/usr/local/share/omabox/hyprland.lua")' "$config"; then
  sed -i 's|^dofile("/usr/local/share/omabox/hyprland.lua")$|dofile("/usr/local/share/omabox/runtime.lua")|' "$config"
fi
if [[ -f $config ]] && ! grep -Fq "$integration" "$config"; then
  printf '\n%s\n' "$integration" >> "$config"
fi

exec /usr/bin/start-hyprland "$@"
